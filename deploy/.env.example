# /opt/readsake/.env on the server (chmod 600). Never commit the real file.

# ─── Database ───
DB_USER=readsake
DB_PASSWORD=change-me            # openssl rand -hex 24
DB_NAME=readsake

# ─── Auth ───
JWT_SECRET=change-me             # openssl rand -base64 48 (>= 32 bytes)
GOOGLE_CLIENT_ID=
REVENUECAT_WEBHOOK_SECRET=

# ─── External APIs ───
GOOGLE_BOOKS_API_KEY=

# ─── Mail (Gmail app password) ───
SMTP_USERNAME=ktite.m3@gmail.com
SMTP_PASSWORD=
MAIL_FROM=ktite.m3@gmail.com

# ─── Book files: Cloudflare R2 (R2 → bucket readsake-books → API token with
#     Object Read & Write on that bucket only). Create the bucket by hand —
#     a bucket-scoped token can't create it.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=readsake-books
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Push (optional) — put the JSON in /opt/readsake/secrets/ ───
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase.json
